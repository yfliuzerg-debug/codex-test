import * as XLSX from "xlsx";
import { analyzeFiles, BASELINE, labelMonth, money, months, type AnalysisResult, type Pack } from "../netlify/functions/_shared/engine.mts";

const esc=(v:any)=>String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const b64=(s:string)=>Buffer.from(s,"utf8").toString("base64url");
const unb64=(s:string)=>Buffer.from(s,"base64url").toString("utf8");

function shell(title:string,body:string){return `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>:root{--nav:#0d1b2a;--bg:#f4f6fa;--panel:#fff;--line:#dbe3ef;--text:#142033;--muted:#6b7688;--blue:#1769ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif}.wrap{max-width:1700px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.top a{color:#1769ff;text-decoration:none}.actions{display:flex;gap:10px}.btn{display:inline-block;background:#1769ff;color:#fff!important;border:0;border-radius:9px;padding:9px 13px;font-weight:600}.cards{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin:16px 0}.card,.panel{background:#fff;border:1px solid #dbe3ef;border-radius:12px;padding:13px}.card b{display:block;font-size:22px}.card span,.muted{color:#6b7688}.panel{margin:14px 0;overflow:auto}.ok{background:#ecfbf3;border:1px solid #bde8cf;padding:10px;border-radius:9px}.warn{background:#fff8e8;border:1px solid #f0d89a;padding:10px;border-radius:9px}table{border-collapse:collapse;width:100%;min-width:1300px}th,td{border-bottom:1px solid #edf0f5;padding:8px;text-align:left}th{background:#f8fafc}.num{text-align:right}.tag{background:#eef5ff;color:#1769ff;border-radius:999px;padding:2px 7px;font-size:12px}.low{color:#98a2b3}.bad{color:#b42318;font-weight:600}.good{color:#067647;font-weight:600}.activity{min-width:220px;max-width:320px}.layout{display:grid;grid-template-columns:210px 1fr;min-height:100vh}.side{background:var(--nav);color:#fff;padding:22px 18px}.side h1{font-size:18px;margin:0 0 4px}.side p{font-size:12px;color:#b7c3d5;margin:0 0 30px}.step{padding:10px 12px;border-radius:9px;margin:7px 0;color:#c9d4e5}.step.active{background:#17365c;color:#fff}.main{padding:26px 28px}.head h2{font-size:24px;margin:0 0 4px}.head p{color:var(--muted);margin:0 0 20px}.notice{padding:12px 14px;border:1px solid #cfe0ff;background:#eef5ff;border-radius:10px;margin-bottom:18px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.file{border:1px dashed #b9c8dd;border-radius:12px;padding:14px}.file b{display:block;margin-bottom:5px}.file small{display:block;color:var(--muted);margin-bottom:10px}.file input{width:100%}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.field label{display:block;font-weight:600;margin-bottom:6px}.field input{width:100%;border:1px solid #cfd8e6;border-radius:9px;padding:10px}.submit{display:flex;justify-content:flex-end;margin-top:16px}@media(max-width:850px){.layout{grid-template-columns:1fr}.side{display:none}.grid,.row{grid-template-columns:1fr}.main{padding:18px}.cards{grid-template-columns:1fr 1fr}.top{display:block}.actions{margin-top:10px}}</style></head><body>${body}</body></html>`}

function home(){return shell("费用规划助手",`<div class="layout"><aside class="side"><h1>费用规划助手</h1><p>Cloudflare Worker 试运行</p><div class="step active">1 数据更新</div><div class="step">2 CP范围</div><div class="step">3 承载 / 拍板</div><div class="step">4 计划输出</div></aside><main class="main"><div class="head"><h2>数据更新</h2><p>BI + TTS + CP预算 + 产品目录 → 服务端解析 → 承载候选 → Overlay下载</p></div><div class="notice">本版用于验证 Cloudflare Free 是否能承担四份 Excel 的服务端解析。访问控制交给 Cloudflare Access，不在代码里保存共享密码。</div><form class="panel" action="/analyze" method="post" enctype="multipart/form-data"><div class="grid"><div class="file"><b>BI</b><small>BI-SO(折扣)、BI-Stock、SKURate、产品目录。</small><input required type="file" name="bi" accept=".xlsx,.xlsm,.xls"></div><div class="file"><b>TTS 最新下载</b><small>读取同CP既有计划、重叠费率和回溯备注日期。</small><input required type="file" name="tts" accept=".xlsx,.xlsm,.xls"></div><div class="file"><b>CP预算</b><small>读取余额、有效期、MG1、渠道、机制。</small><input required type="file" name="cp" accept=".xlsx,.xlsm,.xls"></div><div class="file"><b>产品目录 / 指导价</b><small>读取 SKU、产品描述、NPS未税箱价。</small><input required type="file" name="product" accept=".xlsx,.xlsm,.xls"></div></div><div class="row"><div class="field"><label>重点客户关键词</label><input name="focus" placeholder="可留空；多个客户用逗号分隔"></div><div class="field"><label>最小展示CP余额</label><input name="minBalance" type="number" value="500" min="0" step="100"></div></div><div class="submit"><button class="btn" type="submit">上传并计算</button></div></form></main></div>`)}

function filePanel(ps:Pack[]){const rs=ps.map((p,i)=>{const exp=BASELINE[i],ok=p.sha.startsWith(exp.sha);return`<tr><td>${exp.role}</td><td>${esc(p.name)}</td><td class="num">${(p.size/1024).toFixed(1)}</td><td><code>${p.sha.slice(0,12)}</code></td><td class="${ok?'good':'bad'}">${ok?'与验收基线一致':`不同；基线 ${exp.sha}`}</td></tr>`}).join("");return`<div class="panel"><h3>本次材料指纹</h3><table style="min-width:850px"><thead><tr><th>角色</th><th>文件名</th><th class="num">大小KB</th><th>SHA-256前12位</th><th>基线状态</th></tr></thead><tbody>${rs}</tbody></table></div>`}

function exportPayload(r:AnalysisResult){return{version:"cloudflare-overlay-v1",generatedAt:r.generatedAt,currentMonth:r.currentMonth,overlayRows:r.exportRows,summaryRows:r.matrix.map(x=>({客户:x.name,CP:x.cp.code,活动:x.cp.desc,CP余额:x.cp.balance,历史HARD:x.hard,本月已实现:x.currentActual,本月预测上限:x.currentForecast,未来SOFT:x.soft,同CP扣减:x.deduct,可见上限:x.total,未知费率桶:x.unknown})),fingerprintRows:r.packs.map((p,i)=>({角色:BASELINE[i].role,文件名:p.name,大小KB:+(p.size/1024).toFixed(1),SHA256:p.sha,基线SHA前12位:BASELINE[i].sha,是否与验收基线一致:p.sha.startsWith(BASELINE[i].sha)?"是":"否"})),ruleRows:[{规则:"历史HARD",说明:"按历史实际SO测算；同CP已存在计划按同客户×渠道×产品范围×月份最高折扣率扣减。"},{规则:"500元阈值",说明:"单月净坑位低于500元保留在明细，但不计入可见承载汇总。"},{规则:"本月预测",说明:"已实现SO保持实际；剩余月份由趋势SO与库存隐含SO加权，库存按4周，权重按月初10%/月中20%/月末30%。"},{规则:"未来SOFT",说明:"9月采用R-156预测；库存不直接加入未来SOFT。"}]}}

function resultPage(r:AnalysisResult){const cur=r.currentMonth,allMonths=[...new Set(r.active.flatMap(c=>months(c.start,c.end)))].sort(),payload=b64(JSON.stringify(exportPayload(r)));const cards=`<div class="cards"><div class="card"><span>BI SO行</span><b>${money(r.so.length)}</b></div><div class="card"><span>库存行</span><b>${money(r.stock.length)}</b></div><div class="card"><span>SKU Rate有效/原始</span><b>${money(r.rateInfo.valid.length)} / ${money(r.rateInfo.raw)}</b></div><div class="card"><span>TTS有效折扣行</span><b>${money(r.tts.length)}</b></div><div class="card"><span>可用CP</span><b>${money(r.active.length)}</b></div><div class="card"><span>目录SKU</span><b>${money(r.prices.size)}</b></div></div>`;const summary=`<div class="panel"><h3>客户 × CP 汇总</h3><table><thead><tr><th>客户</th><th>CP</th><th>活动</th><th class="num">余额</th><th class="num">历史HARD</th><th class="num">本月已实现</th><th class="num">本月预测上限</th><th class="num">未来SOFT</th><th class="num">同CP扣减</th><th class="num">可见上限</th></tr></thead><tbody>${r.matrix.map(x=>`<tr><td>${esc(x.name)}</td><td><b>${esc(x.cp.code)}</b></td><td class="activity">${esc(x.cp.desc)}</td><td class="num">${money(x.cp.balance)}</td><td class="num">${money(x.hard)}</td><td class="num">${money(x.currentActual)}</td><td class="num">${money(x.currentForecast)}</td><td class="num">${money(x.soft)}</td><td class="num">${money(x.deduct)}</td><td class="num"><b>${money(x.total)}</b></td></tr>`).join("")}</tbody></table></div>`;const detail=`<div class="panel"><h3>逐月复核</h3><table><thead><tr><th>客户</th><th>CP</th><th class="activity">活动</th>${allMonths.map(m=>`<th class="num">${labelMonth(m)}</th>`).join("")}<th class="num">历史HARD</th><th class="num">含本月已实现</th></tr></thead><tbody>${r.matrix.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.cp.code)}</td><td class="activity">${esc(x.cp.desc)}</td>${allMonths.map(m=>{const v=x.per[m];if(!v)return'<td class="num">—</td>';const show=m<=cur?v.actualNet:v.net,counted=m<=cur?v.actualCounted:v.counted,ded=m<=cur?v.actualDeduct:v.deduct,txt=show>0&&show<500?`<span class="low">${money(show)} &lt;500</span>`:money(counted);return`<td class="num">${txt}${ded>0?`<div class="muted">(-${money(ded)})</div>`:''}</td>`}).join("")}<td class="num"><b>${money(x.hard)}</b></td><td class="num"><b>${money(x.hard+x.currentActual)}</b></td></tr>`).join("")}</tbody></table></div>`;return shell("费用规划助手｜承载结果",`<div class="wrap"><div class="top"><div><h2 style="margin:0">费用规划助手｜承载结果</h2><div class="muted">Cloudflare Worker 试运行</div></div><div class="actions"><form action="/download-analysis" method="post"><input type="hidden" name="payload" value="${payload}"><button class="btn" type="submit">下载分析结果.xlsx</button></form><a href="/">重新上传</a></div></div>${filePanel(r.packs)}${cards}<div class="ok">历史扣重只扣同CP既有计划；本月同时保留已实现与预测上限；下载结果无需服务端存储。</div>${summary}${detail}</div>`)}

function addSheet(wb:XLSX.WorkBook,name:string,rows:Record<string,any>[],widths:number[]){const ws=XLSX.utils.json_to_sheet(rows.length?rows:[{提示:"无数据"}]);ws["!cols"]=widths.map(wch=>({wch}));ws["!autofilter"]=ws["!ref"]?{ref:ws["!ref"]}:undefined;XLSX.utils.book_append_sheet(wb,ws,name);return ws}
function xlsxResponse(payload:any){const wb=XLSX.utils.book_new(),overlay=Array.isArray(payload.overlayRows)?payload.overlayRows:[],summary=Array.isArray(payload.summaryRows)?payload.summaryRows:[],fps=Array.isArray(payload.fingerprintRows)?payload.fingerprintRows:[],rules=Array.isArray(payload.ruleRows)?payload.ruleRows:[];addSheet(wb,"Overlay明细",overlay,[16,24,12,15,28,12,14,34,22,16,10,14,14,10,14,14,14,14,14,42]);addSheet(wb,"客户CP汇总",summary,[28,16,30,14,14,14,14,14,14,14,12]);addSheet(wb,"材料指纹",fps,[14,42,12,68,20,20]);addSheet(wb,"规则说明",rules,[18,80]);const out=XLSX.write(wb,{type:"buffer",bookType:"xlsx",compression:true});const filename=`费用规划助手_分析结果_${new Date().toISOString().slice(0,10).replace(/-/g,"")}.xlsx`;return new Response(out,{headers:{"content-type":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","content-disposition":`attachment; filename*=UTF-8''${encodeURIComponent(filename)}`,"cache-control":"no-store"}})}

export default {async fetch(req:Request,env:any,ctx:any){const u=new URL(req.url);try{if(req.method==="GET"&&(u.pathname==="/"||u.pathname==="/workspace"))return new Response(home(),{headers:{"content-type":"text/html;charset=utf-8","cache-control":"no-store"}});if(req.method==="GET"&&u.pathname==="/health")return Response.json({ok:true,platform:"cloudflare-workers",time:new Date().toISOString()});if(req.method==="POST"&&u.pathname==="/analyze"){const f=await req.formData(),bi=f.get("bi"),tts=f.get("tts"),cp=f.get("cp"),product=f.get("product");if(!(bi instanceof File)||!(tts instanceof File)||!(cp instanceof File)||!(product instanceof File))return new Response("四个文件都必须上传",{status:400});const r=await analyzeFiles({bi,ttsFile:tts,cpFile:cp,product,focus:String(f.get("focus")??""),minBalance:Number(f.get("minBalance")??500)});return new Response(resultPage(r),{headers:{"content-type":"text/html;charset=utf-8","cache-control":"no-store"}})}if(req.method==="POST"&&u.pathname==="/download-analysis"){const f=await req.formData(),raw=String(f.get("payload")??"");if(!raw)return new Response("下载数据不存在",{status:400});return xlsxResponse(JSON.parse(unb64(raw)))}return new Response("Not Found",{status:404})}catch(e:any){return new Response(shell("运行失败",`<div class="wrap"><div class="warn"><b>Cloudflare Worker 运行失败：</b><br>${esc(e?.message||e)}<br><br>如果是 CPU time exceeded，说明 Free Worker 不适合这套 Excel 解析。</div></div>`),{status:500,headers:{"content-type":"text/html;charset=utf-8","cache-control":"no-store"}})}}};
