import type { Context, Config } from "@netlify/functions";
import * as XLSX from "xlsx";

type SO={channel:string;code:string;name:string;brand:string;s1:string;s2:string;s3:string;sku:string;skuName:string;months:Record<string,number>};
type Stock={code:string;name:string;sku:string;cases:number};
type Rate={sku:string;start:Date;end:Date;rate:number};
type TTS={name:string;code:string;channel:string;sku:string;start:Date;end:Date;rate:number;cp:string};
type CP={code:string;start:Date;end:Date;desc:string;mech:string;channels:string;mg1:string[];balance:number};

const EXCLUDE=new Set(["12187803","12585787","12598186","12611209"]);
const norm=(v:any)=>String(v??"").replace(/&amp;/g,"&").replace(/\s+/g,"").replace(/有限责任公司$/,"有限公司").toLowerCase();
const n=(v:any)=>{const x=Number(v);return Number.isFinite(x)?x:0};
const esc=(v:any)=>String(v??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const money=(v:number)=>new Intl.NumberFormat("zh-CN",{maximumFractionDigits:0}).format(v||0);
const month=(d:Date)=>`${d.getFullYear()}${String(d.getMonth()+1).padStart(2,"0")}`;
const list=(v:any)=>String(v??"").split(/[,，;]/).map(x=>x.trim()).filter(Boolean);
const parseDate=(v:any):Date|null=>{if(!v)return null;if(v instanceof Date&&!isNaN(v.getTime()))return v;if(typeof v==="number"){const o=XLSX.SSF.parse_date_code(v);return o?new Date(o.y,o.m-1,o.d):null}const m=String(v).trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m)return new Date(+m[3],+m[1]-1,+m[2]);const d=new Date(String(v));return isNaN(d.getTime())?null:d};
const months=(a:Date,b:Date)=>{const out:string[]=[],d=new Date(a.getFullYear(),a.getMonth(),1),e=new Date(b.getFullYear(),b.getMonth(),1);while(d<=e){out.push(month(d));d.setMonth(d.getMonth()+1)}return out};
const daysIn=(y:number,m:number)=>new Date(y,m,0).getDate();
const parseRate=(v:any)=>{if(typeof v==="string"&&v.includes("%"))return parseFloat(v)/100;return n(v)};
async function read(file:File){return XLSX.read(Buffer.from(await file.arrayBuffer()),{type:"buffer",cellDates:true,raw:true,nodim:true} as any)}
function rows(wb:any,sheet?:string){const sn=sheet&&wb.SheetNames.includes(sheet)?sheet:wb.SheetNames[0];return XLSX.utils.sheet_to_json(wb.Sheets[sn],{header:1,defval:null,raw:true}) as any[][]}
function header(rs:any[][],need:string[]){return rs.findIndex(r=>need.every(k=>r.some(c=>String(c??"").trim()===k)))}
function ix(h:any[]){const o:Record<string,number>={};h.forEach((v,i)=>{if(v!=null)o[String(v).trim()]=i});return o}
function biMeta(wb:any){const out=new Map<string,{brand:string;s3:string}>();if(!wb.SheetNames.includes("产品目录"))return out;const rs=rows(wb,"产品目录"),hi=header(rs,["SKU","SKU Name CN"]);if(hi<0)return out;const x=ix(rs[hi]);for(const r of rs.slice(hi+1)){const sku=String(r[x["SKU"]]??"");if(sku)out.set(sku,{brand:String(r[x["Brand Name"]]??""),s3:String(r[x["PH5 Segment3_Detail"]]??"")})}return out}
function parseSO(wb:any):SO[]{if(!wb.SheetNames.includes("BI-SO(折扣)"))return[];const meta=biMeta(wb),rs=rows(wb,"BI-SO(折扣)"),hi=header(rs,["Outlet Channel","Customer Code","SKU"]);if(hi<0)return[];const h=rs[hi].map(v=>String(v??"").trim()),x=ix(h),mc=h.map((v,i)=>/^20\d{4}$/.test(v)?[v,i]:null).filter(Boolean) as [string,number][];return rs.slice(hi+1).map(r=>{const sku=String(r[x["SKU"]]??""),m=meta.get(sku);return{channel:String(r[x["Outlet Channel"]]??""),code:String(r[x["Customer Code"]]??""),name:String(r[x["Customer Name"]]??""),brand:m?.brand||String(r[x["Brand Name"]]??""),s1:String(r[x["PH5 Segment1_MKT"]]??""),s2:String(r[x["PH5 Segment2_Detail"]]??""),s3:m?.s3||"",sku,skuName:String(r[x["SKU Name CN"]]??""),months:Object.fromEntries(mc.map(([mm,i])=>[mm,n(r[i])]))}}).filter(r=>r.name&&r.sku&&!/汇总/.test(r.code))}
function parseStock(wb:any):Stock[]{if(!wb.SheetNames.includes("BI-Stock"))return[];const rs=rows(wb,"BI-Stock"),hi=header(rs,["Customer Code","Customer Name","SKU","SOH (Good) Case"]);if(hi<0)return[];const x=ix(rs[hi]);return rs.slice(hi+1).map(r=>({code:String(r[x["Customer Code"]]??""),name:String(r[x["Customer Name"]]??""),sku:String(r[x["SKU"]]??""),cases:n(r[x["SOH (Good) Case"]])})).filter(r=>r.name&&r.sku&&r.cases!==0)}
function parseRates(wb:any):Rate[]{if(!wb.SheetNames.includes("SKURate"))return[];const rs=rows(wb,"SKURate"),hi=header(rs,["SKUCode","StartDate","EndDate","Rate"]);if(hi<0)return[];const x=ix(rs[hi]),out:Rate[]=[];for(const r of rs.slice(hi+1)){const start=parseDate(r[x["StartDate"]]),end=parseDate(r[x["EndDate"]]),sku=String(r[x["SKUCode"]]??""),rate=parseRate(r[x["_RateValue"]]??r[x["Rate"]]);if(start&&end&&sku)out.push({sku,start,end,rate})}return out}
function parsePrices(wb:any){const out=new Map<string,number>();for(const sn of wb.SheetNames){const rs=rows(wb,sn),hi=header(rs,["产品编码"]);if(hi<0)continue;const h=rs[hi].map(v=>String(v??"").trim()),x=ix(h),si=x["产品编码"];let pi=h.findIndex(v=>v.includes("NPS")&&v.includes("未税箱价"));if(pi<0)pi=x["Price"];if(pi==null||pi<0)continue;for(const r of rs.slice(hi+1)){const sku=String(r[si]??""),p=n(r[pi]);if(sku&&p>0)out.set(sku,p)}}return out}
function parseTTS(wb:any):TTS[]{const rs=rows(wb,wb.SheetNames.includes("PPCenturyBigTable")?"PPCenturyBigTable":undefined),hi=header(rs,["PPCode","Distributor Name","Activity Code in Cycle Plan"]);if(hi<0)return[];const x=ix(rs[hi]),out:TTS[]=[];for(const r of rs.slice(hi+1)){let rate=parseRate(r[x["Disc.Rate"]]);const start=parseDate(r[x["RemarkStartDate"]])||parseDate(r[x["Promotion Start Date"]]),end=parseDate(r[x["RemarkEndDate"]])||parseDate(r[x["Promotion End Date"]]);if(rate>0&&start&&end&&r[x["Distributor Name"]]&&r[x["Product Code"]])out.push({name:String(r[x["Distributor Name"]]),code:String(r[x["Distributor Code"]]??""),channel:String(r[x["Channel"]]??""),sku:String(r[x["Product Code"]]),start,end,rate,cp:String(r[x["Activity Code in Cycle Plan"]]??"")})}return out}
function parseCP(wb:any):CP[]{const rs=rows(wb,wb.SheetNames.includes("CPCenturyBigTableByCGAmount")?"CPCenturyBigTableByCGAmount":undefined),hi=header(rs,["Activity Code","Activity Start Date","Balance Amount"]);if(hi<0)return[];const x=ix(rs[hi]),out:CP[]=[];for(const r of rs.slice(hi+1)){const start=parseDate(r[x["Activity Start Date"]]),end=parseDate(r[x["Activity End Date"]]),balance=n(r[x["Balance Amount"]]);if(start&&end&&balance>0&&r[x["Activity Code"]])out.push({code:String(r[x["Activity Code"]]),start,end,desc:String(r[x["Activity Description"]]??""),mech:String(r[x["Activity Mechanism"]]??""),channels:String(r[x["SubChannel"]]??""),mg1:list(r[x["MG1"]]),balance})}return out}
function clientOK(cp:CP,name:string){return cp.code!=="DA202601011TT"||["天虹","东方"].some(k=>name.includes(k))}
function channelOK(cp:CP,ch:string){const c=norm(cp.channels),x=norm(ch);if(!c)return true;if(c.includes(x))return true;const a:Record<string,string[]>={sm:["hyper&super","lka"],hm:["hyper&super"],ws:["wholesale"],"mm-a":["mm-a"],"mm-b":["mm-b"],"mm-c":["mm-c"],speciality:["specialty"],ss_kiosks:["smallstore"]};return(a[x]||[]).some(v=>c.includes(norm(v)))}
function eligible(cp:CP,r:SO){if(!clientOK(cp,r.name)||EXCLUDE.has(r.sku)||!channelOK(cp,r.channel))return false;const explicit:string[]=[];if(/新西兰/.test(cp.mech))explicit.push("新西兰");if(/全脂375g/.test(cp.mech))explicit.push("全脂375g");if(/甜奶粉/.test(cp.mech))explicit.push("甜奶粉300g");if(explicit.length)return explicit.some(v=>r.s3.includes(v));if(cp.mg1.length)return cp.mg1.some(v=>norm(v)===norm(r.brand));return true}
function skuRate(rs:Rate[],sku:string,mm:string){const y=+mm.slice(0,4),m=+mm.slice(4,6),s=new Date(y,m-1,1),e=new Date(y,m,0),vals=[...new Set(rs.filter(r=>r.sku===sku&&r.start<=e&&r.end>=s&&r.rate>0).map(r=>+r.rate.toFixed(6)))];return vals.length===1?vals[0]:null}
function mechRate(cp:CP,r:SO){const t=(cp.desc+" "+cp.mech).replace(/：/g,":"),s=(r.s1+" "+r.s2+" "+r.s3+" "+r.skuName).toLowerCase();const tests:[RegExp,string][]=[[/中老年[^%]{0,40}?(\d+(?:\.\d+)?)%/i,"senior"],[/N3[^%]{0,40}?(\d+(?:\.\d+)?)%/i,"n3"],[/全家[^%]{0,40}?(\d+(?:\.\d+)?)%/i,"family"]];for(const[q,k]of tests)if(s.includes(k)){const m=t.match(q);if(m)return Number(m[1])/100}const all=[...t.matchAll(/(\d+(?:\.\d+)?)\s*%/g)].map(m=>Number(m[1])/100),u=[...new Set(all)];return u.length===1?u[0]:null}
function targetRate(cp:CP,r:SO,rs:Rate[],mm:string){return mechRate(cp,r)??skuRate(rs,r.sku,mm)}
function overlap(tts:TTS[],r:SO,mm:string){let mx=0;for(const p of tts){if(norm(p.name)!==norm(r.name)||p.sku!==r.sku)continue;if(p.channel&&r.channel&&!norm(p.channel).includes(norm(r.channel))&&!norm(r.channel).includes(norm(p.channel)))continue;if(months(p.start,p.end).includes(mm))mx=Math.max(mx,p.rate)}return mx}
function r156(r:SO){const ly=r.months["202509"]||0,avg=((r.months["202605"]||0)+(r.months["202606"]||0)+(r.months["202607"]||0))/3;return Math.max(ly,(ly+avg)/2)*1000}
function currentBasis(r:SO,stockValue:number,now:Date){const mm=month(now),actual=(r.months[mm]||0)*1000,done=Math.max(1,now.getDate()-1),remaining=Math.max(0,daysIn(now.getFullYear(),now.getMonth()+1)-done),trend=actual/done*remaining,inventory=stockValue/4*(remaining/7),w=now.getDate()<=10?.10:now.getDate()<=20?.20:.30;return actual+trend*(1-w)+inventory*w}
function html(title:string,body:string){return`<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>body{margin:0;background:#f4f6fa;color:#142033;font:14px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif}.w{max-width:1500px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between}.top a{color:#1769ff}.cards{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin:16px 0}.card,.p{background:#fff;border:1px solid #dbe3ef;border-radius:12px;padding:13px}.card b{display:block;font-size:22px}.card span,.muted{color:#6b7688}.p{margin:14px 0;overflow:auto}.ok{background:#ecfbf3;border:1px solid #bde8cf;padding:10px;border-radius:9px}.warn{background:#fff8e8;border:1px solid #f0d89a;padding:10px;border-radius:9px}table{border-collapse:collapse;width:100%;min-width:1100px}th,td{border-bottom:1px solid #edf0f5;padding:8px;text-align:left}th{background:#f8fafc}.num{text-align:right}.tag{background:#eef5ff;color:#1769ff;border-radius:999px;padding:2px 7px;font-size:12px}@media(max-width:900px){.cards{grid-template-columns:1fr 1fr}}</style></head><body><div class="w"><div class="top"><div><h2 style="margin:0">${esc(title)}</h2><div class="muted">Netlify 服务端计算</div></div><a href="/">重新上传</a></div>${body}</div></body></html>`}
function selftest(){const wb=XLSX.utils.book_new(),ws=XLSX.utils.aoa_to_sheet([["A","B"],[1,2],[3,4]]);(ws as any)["!ref"]="A1:B1";XLSX.utils.book_append_sheet(wb,ws,"T");const b=XLSX.write(wb,{type:"buffer",bookType:"xlsx"});const r=XLSX.read(b,{type:"buffer",nodim:true} as any);return(XLSX.utils.sheet_to_json(r.Sheets.T,{header:1}) as any[][]).length>=3}

export default async(req:Request,ctx:Context)=>{const u=new URL(req.url);if(req.method==="GET"&&u.searchParams.get("selftest")==="1")return new Response(JSON.stringify({ok:selftest(),engine:"analyze2",time:new Date().toISOString()}),{headers:{"content-type":"application/json"}});if(req.method!=="POST")return new Response("Method Not Allowed",{status:405});try{const f=await req.formData(),bi=f.get("bi"),tf=f.get("tts"),cf=f.get("cp"),pf=f.get("product");if(!(bi instanceof File)||!(tf instanceof File)||!(cf instanceof File)||!(pf instanceof File))return new Response(html("文件不完整",`<div class="warn">四个文件都必须上传。</div>`),{status:400,headers:{"content-type":"text/html;charset=utf-8"}});const[bw,tw,cw,pw]=await Promise.all([read(bi),read(tf),read(cf),read(pf)]),so=parseSO(bw),stock=parseStock(bw),rates=parseRates(bw),tts=parseTTS(tw),cps=parseCP(cw),prices=parsePrices(pw);const focus=String(f.get("focus")??"").split(/[,，]/).map(v=>v.trim()).filter(Boolean),min=n(f.get("minBalance")??500),now=new Date(),cur=month(now),active=cps.filter(c=>c.balance>=min).sort((a,b)=>b.balance-a.balance),sm=new Map<string,number>();for(const s of stock){const k=`${norm(s.name)}|${s.sku}`;sm.set(k,(sm.get(k)||0)+s.cases*(prices.get(s.sku)||0))}let names=[...new Set(so.map(r=>r.name))];if(focus.length)names=names.filter(v=>focus.some(q=>norm(v).includes(norm(q))));else names=names.slice(0,30);const mat:any[]=[];for(const name of names)for(const cp of active){let hard=0,current=0,soft=0,deduct=0,unknown=0;for(const r of so){if(norm(r.name)!==norm(name)||!eligible(cp,r))continue;for(const mm of months(cp.start,cp.end)){const rate=targetRate(cp,r,rates,mm);if(rate==null){unknown++;continue}const ov=overlap(tts,r,mm),eff=Math.max(0,rate-ov);let base=0,kind="hard";if(mm===cur){base=currentBasis(r,sm.get(`${norm(name)}|${r.sku}`)||0,now);kind="current"}else if(mm>cur){base=mm==="202609"?r156(r):0;kind="soft"}else base=(r.months[mm]||0)*1000;if(base<=0)continue;deduct+=base*Math.min(rate,ov);const fee=base*eff;if(kind==="hard")hard+=fee;else if(kind==="current")current+=fee;else soft+=fee}}mat.push({name,cp,hard,current,soft,deduct,total:Math.min(cp.balance,hard+current+soft),unknown})}const cards=`<div class="cards"><div class="card"><span>BI SO行</span><b>${money(so.length)}</b></div><div class="card"><span>库存行</span><b>${money(stock.length)}</b></div><div class="card"><span>SKU Rate</span><b>${money(rates.length)}</b></div><div class="card"><span>TTS折扣行</span><b>${money(tts.length)}</b></div><div class="card"><span>可用CP</span><b>${money(active.length)}</b></div><div class="card"><span>目录SKU</span><b>${money(prices.size)}</b></div></div>`,note=`<div class="ok">解析完成。TTS优先使用备注计划日期；本月采用已实现SO + 剩余趋势/库存隐含SO加权，库存按4周且权重10%/20%/30%；9月采用R-156，库存不直接加到未来SOFT。</div>`,table=`<div class="p"><h3>客户 × CP 承载候选</h3><table><thead><tr><th>客户</th><th>CP</th><th>活动</th><th class="num">余额</th><th class="num">历史HARD</th><th class="num">本月预测</th><th class="num">9月SOFT</th><th class="num">重叠扣减</th><th class="num">可见上限</th><th>状态</th></tr></thead><tbody>${mat.map(x=>`<tr><td>${esc(x.name)}</td><td><b>${esc(x.cp.code)}</b></td><td>${esc(x.cp.desc)}</td><td class="num">${money(x.cp.balance)}</td><td class="num">${money(x.hard)}</td><td class="num">${money(x.current)}</td><td class="num">${money(x.soft)}</td><td class="num">${money(x.deduct)}</td><td class="num"><b>${money(x.total)}</b></td><td>${x.unknown?`<span class="tag">${x.unknown}个费率桶待确认</span>`:'<span class="tag">可测算</span>'}</td></tr>`).join("")}</tbody></table></div>`;return new Response(html("费用规划助手｜承载结果",cards+note+table+`<div class="warn">当前先验收承载准确性；拍板和自动模板输出随后接入。</div>`),{headers:{"content-type":"text/html;charset=utf-8","cache-control":"no-store"}})}catch(e:any){return new Response(html("计算失败",`<div class="warn">${esc(e?.message||e)}</div>`),{status:500,headers:{"content-type":"text/html;charset=utf-8"}})}};
export const config:Config={path:"/analyze2"};
