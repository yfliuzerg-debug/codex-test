const labelMonth=(m:string)=>`${+m.slice(4)}月`;
const list=(v:any)=>String(v??"").split(/[,，;]/).map(x=>x.trim()).filter(Boolean);
const parseDate=(v:any):Date|null=>{if(!v)return null;if(v instanceof Date&&!isNaN(v.getTime()))return v;if(typeof v==="number"){const o=XLSX.SSF.parse_date_code(v);return o?new Date(o.y,o.m-1,o.d):null}const s=String(v).trim(),m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m)return new Date(+m[3],+m[1]-1,+m[2]);const d=new Date(s);return isNaN(d.getTime())?null:d};
const months=(a:Date,b:Date)=>{const out:string[]=[],d=new Date(a.getFullYear(),a.getMonth(),1),e=new Date(b.getFullYear(),b.getMonth(),1);while(d<=e){out.push(month(d));d.setMonth(d.getMonth()+1)}return out};
const daysIn=(y:number,m:number)=>new Date(y,m,0).getDate();
const parseRate=(v:any)=>{if(typeof v==="string"&&v.includes("%"))return parseFloat(v)/100;const x=n(v);return x>1?x/100:x};
async function pack(file:File):Promise<Pack>{const ab=await file.arrayBuffer(),buf=Buffer.from(ab),dig=await crypto.subtle.digest("SHA-256",ab),sha=Array.from(new Uint8Array(dig)).map(x=>x.toString(16).padStart(2,"0")).join("");return{wb:XLSX.read(buf,{type:"buffer",cellDates:true,raw:true}),name:file.name,size:file.size,sha}}
function expandRef(ws:any){let maxR=0,maxC=0,seen=false;for(const k of Object.keys(ws)){if(k.startsWith("!"))continue;const m=k.match(/^([A-Z]+)(\d+)$/);if(!m)continue;const c=XLSX.utils.decode_col(m[1]),r=+m[2]-1;maxC=Math.max(maxC,c);maxR=Math.max(maxR,r);seen=true}if(seen)ws["!ref"]=XLSX.utils.encode_range({s:{r:0,c:0},e:{r:maxR,c:maxC}})}
function rows(wb:any,sheet?:string){const sn=sheet&&wb.SheetNames.includes(sheet)?sheet:wb.SheetNames[0],ws=wb.Sheets[sn];expandRef(ws);return XLSX.utils.sheet_to_json(ws,{header:1,defval:null,raw:true}) as any[][]}
function header(rs:any[][],need:string[]){return rs.findIndex(r=>need.every(k=>r.some(c=>String(c??"").trim()===k)))}
function ix(h:any[]){const o:Record<string,number>={};h.forEach((v,i)=>{if(v!=null)o[String(v).trim()]=i});return o}
function biMeta(wb:any){const out=new Map<string,{brand:string;s3:string}>();if(!wb.SheetNames.includes("产品目录"))return out;const rs=rows(wb,"产品目录"),hi=header(rs,["SKU","SKU Name CN"]);if(hi<0)return out;const x=ix(rs[hi]);for(const r of rs.slice(hi+1)){const sku=String(r[x["SKU"]]??"");if(sku)out.set(sku,{brand:String(r[x["Brand Name"]]??""),s3:String(r[x["PH5 Segment3_Detail"]]??"")})}return out}
function parseSO(wb:any):SO[]{if(!wb.SheetNames.includes("BI-SO(折扣)"))return[];const meta=biMeta(wb),rs=rows(wb,"BI-SO(折扣)"),hi=header(rs,["Outlet Channel","Customer Code","SKU"]);if(hi<0)return[];const h=rs[hi].map(v=>String(v??"").trim()),x=ix(h),mc=h.map((v,i)=>/^20\d{4}$/.test(v)?[v,i]:null).filter(Boolean) as [string,number][];return rs.slice(hi+1).map(r=>{const sku=String(r[x["SKU"]]??""),m=meta.get(sku);return{channel:String(r[x["Outlet Channel"]]??""),code:String(r[x["Customer Code"]]??""),name:String(r[x["Customer Name"]]??""),brand:m?.brand||String(r[x["Brand Name"]]??""),s1:String(r[x["PH5 Segment1_MKT"]]??""),s2:String(r[x["PH5 Segment2_Detail"]]??""),s3:m?.s3||"",sku,skuName:String(r[x["SKU Name CN"]]??""),months:Object.fromEntries(mc.map(([mm,i])=>[mm,n(r[i])]))}}).filter(r=>r.name&&r.sku&&!/汇总/.test(r.code))}
function parseStock(wb:any):Stock[]{if(!wb.SheetNames.includes("BI-Stock"))return[];const rs=rows(wb,"BI-Stock"),hi=header(rs,["Customer Code","Customer Name","SKU","SOH (Good) Case"]);if(hi<0)return[];const x=ix(rs[hi]);return rs.slice(hi+1).map(r=>({code:String(r[x["Customer Code"]]??""),name:String(r[x["Customer Name"]]??""),sku:String(r[x["SKU"]]??""),cases:n(r[x["SOH (Good) Case"]])})).filter(r=>r.name&&r.sku&&r.cases!==0)}
function parseRates(wb:any):Rate[]{if(!wb.SheetNames.includes("SKURate"))return[];const rs=rows(wb,"SKURate"),hi=header(rs,["SKUCode","StartDate","EndDate","Rate"]);if(hi<0)return[];const x=ix(rs[hi]),out:Rate[]=[];for(const r of rs.slice(hi+1)){const start=parseDate(r[x["StartDate"]]),end=parseDate(r[x["EndDate"]]),sku=String(r[x["SKUCode"]]??""),rate=parseRate(r[x["_RateValue"]]??r[x["Rate"]]);if(start&&end&&sku&&rate>0)out.push({sku,start,end,rate})}return out}
function parsePrices(wb:any){const out=new Map<string,number>();for(const sn of wb.SheetNames){const rs=rows(wb,sn),hi=header(rs,["产品编码"]);if(hi<0)continue;const h=rs[hi].map(v=>String(v??"").trim()),x=ix(h),si=x["产品编码"];let pi=h.findIndex(v=>v.includes("NPS")&&v.includes("未税箱价"));if(pi<0)pi=x["Price"];if(pi==null||pi<0)continue;for(const r of rs.slice(hi+1)){const sku=String(r[si]??""),p=n(r[pi]);if(sku&&p>0)out.set(sku,p)}}return out}
function parseTTS(wb:any):TTS[]{const rs=rows(wb,wb.SheetNames.includes("PPCenturyBigTable")?"PPCenturyBigTable":undefined),hi=header(rs,["PPCode","Distributor Name","Activity Code in Cycle Plan"]);if(hi<0)return[];const x=ix(rs[hi]),out:TTS[]=[];for(const r of rs.slice(hi+1)){const rate=parseRate(r[x["Disc.Rate"]]),start=parseDate(r[x["RemarkStartDate"]])||parseDate(r[x["Promotion Start Date"]]),end=parseDate(r[x["RemarkEndDate"]])||parseDate(r[x["Promotion End Date"]]);if(rate>0&&start&&end&&r[x["Distributor Name"]]&&r[x["Product Code"]])out.push({name:String(r[x["Distributor Name"]]),code:String(r[x["Distributor Code"]]??""),channel:String(r[x["Channel"]]??""),sku:String(r[x["Product Code"]]),start,end,rate,cp:String(r[x["Activity Code in Cycle Plan"]]??""),remarks:String(r[x["Remarks"]]??""),productRemark:String(r[x["Product Remark"]]??""),mg1:String(r[x["MG1 Descpription"]]??"")})}return out}
function parseCP(wb:any):CP[]{const rs=rows(wb,wb.SheetNames.includes("CPCenturyBigTableByCGAmount")?"CPCenturyBigTableByCGAmount":undefined),hi=header(rs,["Activity Code","Activity Start Date","Balance Amount"]);if(hi<0)return[];const x=ix(rs[hi]),out:CP[]=[];for(const r of rs.slice(hi+1)){const start=parseDate(r[x["Activity Start Date"]]),end=parseDate(r[x["Activity End Date"]]),balance=n(r[x["Balance Amount"]]);if(start&&end&&balance>0&&r[x["Activity Code"]])out.push({code:String(r[x["Activity Code"]]),start,end,desc:String(r[x["Activity Description"]]??""),mech:String(r[x["Activity Mechanism"]]??""),channels:String(r[x["SubChannel"]]??""),mg1:list(r[x["MG1"]]),balance})}return out}
function clientOK(cp:CP,name:string){return cp.code!=="DA202601011TT"||["天虹","东方"].some(k=>name.includes(k))}
function channelTokens(bi:string){const x=norm(bi);const a:Record<string,string[]>={sm:["hyper&super","lkagroup","lkaothers"],hm:["hyper&super"],ws:["wholesale"],"mm-a":["mm-a"],"mm-b":["mm-b"],"mm-c":["mm-c"],speciality:["specialty"],ss_kiosks:["smallstore"],sd1:["sd1","sub-d"],scd:["scd"],cgp:["cgp"],b2b:["b2b"],b2c:["b2c"],cvs:["cvs"]};return a[x]||[x]}
function channelOK(cp:CP,ch:string){const c=norm(cp.channels);return!c||channelTokens(ch).some(v=>c.includes(norm(v)))}
function ttsChannelOK(tch:string,bch:string){const t=norm(tch);return!t||channelTokens(bch).some(v=>t.includes(norm(v)))}
function eligible(cp:CP,r:SO){if(!clientOK(cp,r.name)||EXCLUDE.has(r.sku)||!channelOK(cp,r.channel))return false;const explicit:string[]=[];if(/新西兰/.test(cp.mech))explicit.push("新西兰");if(/全脂375g/.test(cp.mech))explicit.push("全脂375g");if(/甜奶粉/.test(cp.mech))explicit.push("甜奶粉300g");if(explicit.length)return explicit.some(v=>r.s3.includes(v));if(cp.mg1.length)return cp.mg1.some(v=>norm(v)===norm(r.brand));return true}
function skuRate(rs:Rate[],sku:string,mm:string){const y=+mm.slice(0,4),m=+mm.slice(4,6),s=new Date(y,m-1,1),e=new Date(y,m,0),vals=[...new Set(rs.filter(r=>r.sku===sku&&r.start<=e&&r.end>=s&&r.rate>0).map(r=>+r.rate.toFixed(6)))];return vals.length===1?vals[0]:null}
function mechRate(cp:CP,r:SO){const t=(cp.desc+" "+cp.mech).replace(/：/g,":"),s=(r.s1+" "+r.s2+" "+r.s3+" "+r.skuName).toLowerCase(),tests:[RegExp,string][]=[[/中老年[^%]{0,40}?(\d+(?:\.\d+)?)%/i,"senior"],[/N3[^%]{0,40}?(\d+(?:\.\d+)?)%/i,"n3"],[/全家[^%]{0,40}?(\d+(?:\.\d+)?)%/i,"family"]];for(const[q,k]of tests)if(s.includes(k)){const m=t.match(q);if(m)return Number(m[1])/100}const all=[...t.matchAll(/(\d+(?:\.\d+)?)\s*%/g)].map(m=>Number(m[1])/100),u=[...new Set(all)];return u.length===1?u[0]:null}
function cpRateFromTTS(cp:CP,tts:TTS[]){const u=[...new Set(tts.filter(t=>t.cp===cp.code).map(t=>+t.rate.toFixed(6)))];return u.length===1?u[0]:null}
function targetRate(cp:CP,r:SO,rs:Rate[],tts:TTS[],mm:string){return cpRateFromTTS(cp,tts)??mechRate(cp,r)??skuRate(rs,r.sku,mm)}
function ttsScopeOK(p:TTS,r:SO){if(p.sku===r.sku)return true;if(p.mg1&&norm(p.mg1)===norm(r.brand))return true;const z=p.remarks+" "+p.productRemark;if(r.s3==="新西兰"&&/新西兰/.test(z))return true;if(r.s3==="全脂375g"&&/全脂375g/.test(z))return true;if(r.s3==="甜奶粉300g"&&/(300g甜奶粉|甜奶粉)/.test(z))return true;const s=(r.s1+" "+r.s2+" "+r.s3+" "+r.brand+" "+r.skuName).toLowerCase();if(/中老年/.test(z)&&s.includes("senior"))return true;if(/n3/i.test(z)&&s.includes("n3"))return true;if(/全家/.test(z)&&(s.includes("family")||s.includes("fcmp")||s.includes("全家")))return true;return false}
function overlap(tts:TTS[],r:SO,mm:string){let mx=0;for(const p of tts){if(norm(p.name)!==norm(r.name)||!ttsChannelOK(p.channel,r.channel)||!ttsScopeOK(p,r))continue;if(months(p.start,p.end).includes(mm))mx=Math.max(mx,p.rate)}return mx}
function r156(r:SO){const ly=r.months["202509"]||0,avg=((r.months["202605"]||0)+(r.months["202606"]||0)+(r.months["202607"]||0))/3;return Math.max(0,Math.max(ly,(ly+avg)/2)*1000)}
function currentActual(r:SO,mm:string){return Math.max(0,(r.months[mm]||0)*1000)}
function stockShare(so:SO[],r:SO,mm:string){const group=so.filter(x=>norm(x.name)===norm(r.name)&&x.sku===r.sku),pos=group.map(x=>currentActual(x,mm)),sum=pos.reduce((a,b)=>a+b,0);if(sum>0)return currentActual(r,mm)/sum;const hist=group.map(x=>Math.max(0,(x.months["202607"]||0)+(x.months["202606"]||0)+(x.months["202605"]||0))),hs=hist.reduce((a,b)=>a+b,0);const i=group.indexOf(r);return hs>0?hist[i]/hs:1/Math.max(1,group.length)}
function currentBasis(so:SO[],r:SO,stockValue:number,now:Date){const mm=month(now),actual=currentActual(r,mm),done=Math.max(1,now.getDate()-1),remaining=Math.max(0,daysIn(now.getFullYear(),now.getMonth()+1)-done),trend=actual/done*remaining,inv=stockValue*stockShare(so,r,mm)/4*(remaining/7),w=now.getDate()<=10?.10:now.getDate()<=20?.20:.30;return actual+trend*(1-w)+inv*w}
function page(title:string,body:string){return`<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(title)}</title><style>body{margin:0;background:#f4f6fa;color:#142033;font:14px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif}.w{max-width:1600px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between}.top a{color:#1769ff}.cards{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin:16px 0}.card,.p{background:#fff;border:1px solid #dbe3ef;border-radius:12px;padding:13px}.card b{display:block;font-size:22px}.card span,.muted{color:#6b7688}.p{margin:14px 0;overflow:auto}.ok{background:#ecfbf3;border:1px solid #bde8cf;padding:10px;border-radius:9px}.warn{background:#fff8e8;border:1px solid #f0d89a;padding:10px;border-radius:9px}table{border-collapse:collapse;width:100%;min-width:1150px}th,td{border-bottom:1px solid #edf0f5;padding:8px;text-align:left}th{background:#f8fafc}.num{text-align:right}.tag{background:#eef5ff;color:#1769ff;border-radius:999px;padding:2px 7px;font-size:12px}.low{color:#98a2b3}@media(max-width:900px){.cards{grid-template-columns:1fr 1fr}}</style></head><body><div class="w"><div class="top"><div><h2 style="margin:0">${esc(title)}</h2><div class="muted">Netlify 服务端计算 · 月度可复核</div></div><a href="/">重新上传</a></div>${body}</div></body></html>`}
function filePanel(ps:Pack[]){return`<div class="p"><h3>本次材料指纹</h3><table style="min-width:700px"><thead><tr><th>角色</th><th>文件名</th><th class="num">大小KB</th><th>SHA-256前12位</th></tr></thead><tbody>${ps.map((p,i)=>`<tr><td>${["BI","TTS","CP预算","产品目录"][i]}</td><td>${esc(p.name)}</td><td class="num">${(p.size/1024).toFixed(1)}</td><td><code>${p.sha.slice(0,12)}</code></td></tr>`).join("")}</tbody></table></div>`}

export default async(req:Request,ctx:Context)=>{const u=new URL(req.url);if(req.method!=="POST")return new Response("Method Not Allowed",{status:405});try{const f=await req.formData(),bi=f.get("bi"),tf=f.get("tts"),cf=f.get("cp"),pf=f.get("product");if(!(bi instanceof File)||!(tf instanceof File)||!(cf instanceof File)||!(pf instanceof File))return new Response(page("文件不完整",`<div class="warn">四个文件都必须上传。</div>`),{status:400,headers:{"content-type":"text/html;charset=utf-8"}});const[bp,tp,cpPack,pp]=await Promise.all([pack(bi),pack(tf),pack(cf),pack(pf)]),so=parseSO(bp.wb),stock=parseStock(bp.wb),rates=parseRates(bp.wb),tts=parseTTS(tp.wb),cps=parseCP(cpPack.wb),prices=parsePrices(pp.wb);const focus=String(f.get("focus")??"").split(/[,，]/).map(v=>v.trim()).filter(Boolean),min=n(f.get("minBalance")??500),now=new Date(),cur=month(now),active=cps.filter(c=>c.balance>=min).sort((a,b)=>b.balance-a.balance),sm=new Map<string,number>();for(const s of stock){const k=`${norm(s.name)}|${s.sku}`;sm.set(k,(sm.get(k)||0)+s.cases*(prices.get(s.sku)||0))}let names=[...new Set(so.map(r=>r.name))];if(focus.length)names=names.filter(v=>focus.some(q=>norm(v).includes(norm(q))));else names=names.slice(0,30);const matrix:any[]=[];for(const name of names)for(const cp of active){const per:Record<string,{raw:number;deduct:number;net:number;counted:number;unknown:number;kind:string}>={};for(const mm of months(cp.start,cp.end))per[mm]={raw:0,deduct:0,net:0,counted:0,unknown:0,kind:mm<cur?"HARD":mm===cur?"CURRENT":"SOFT"};for(const r of so){if(norm(r.name)!==norm(name)||!eligible(cp,r))continue;for(const mm of Object.keys(per)){const rate=targetRate(cp,r,rates,tts,mm);if(rate==null){per[mm].unknown++;continue}const ov=overlap(tts,r,mm),eff=Math.max(0,rate-ov);let base=0;if(mm<cur)base=Math.max(0,(r.months[mm]||0)*1000);else if(mm===cur)base=currentBasis(so,r,sm.get(`${norm(name)}|${r.sku}`)||0,now);else if(mm==="202609")base=r156(r);if(base<=0)continue;per[mm].raw+=base*rate;per[mm].deduct+=base*Math.min(rate,ov);per[mm].net+=base*eff}}for(const mm of Object.keys(per))per[mm].counted=per[mm].net>=500?per[mm].net:0;const hard=Object.entries(per).filter(([m])=>m<cur).reduce((a,[,v])=>a+v.counted,0),current=per[cur]?.counted||0,soft=Object.entries(per).filter(([m])=>m>cur).reduce((a,[,v])=>a+v.counted,0),deduct=Object.values(per).reduce((a,v)=>a+v.deduct,0),unknown=Object.values(per).reduce((a,v)=>a+v.unknown,0);matrix.push({name,cp,per,hard,current,soft,deduct,total:Math.min(cp.balance,hard+current+soft),unknown})}const cards=`<div class="cards"><div class="card"><span>BI SO行</span><b>${money(so.length)}</b></div><div class="card"><span>库存行</span><b>${money(stock.length)}</b></div><div class="card"><span>SKU Rate</span><b>${money(rates.length)}</b></div><div class="card"><span>TTS有效折扣行</span><b>${money(tts.length)}</b></div><div class="card"><span>可用CP</span><b>${money(active.length)}</b></div><div class="card"><span>目录SKU</span><b>${money(prices.size)}</b></div></div>`,note=`<div class="ok">口径已按人工基线重做：历史月只累计正SO；重叠折扣按客户×渠道×产品范围×月份取最高已存在折扣率；代表SKU备注可扩展到其Remarks声明的产品范围；月净坑位低于500不计入可见承载。CP本身费率优先从同CP既有TTS计划唯一费率识别。</div>`,summary=`<div class="p"><h3>客户 × CP 汇总</h3><table><thead><tr><th>客户</th><th>CP</th><th>活动</th><th class="num">余额</th><th class="num">历史HARD</th><th class="num">本月预测</th><th class="num">未来SOFT</th><th class="num">重叠扣减</th><th class="num">可见上限</th><th>状态</th></tr></thead><tbody>${matrix.map(x=>`<tr><td>${esc(x.name)}</td><td><b>${esc(x.cp.code)}</b></td><td>${esc(x.cp.desc)}</td><td class="num">${money(x.cp.balance)}</td><td class="num">${money(x.hard)}</td><td class="num">${money(x.current)}</td><td class="num">${money(x.soft)}</td><td class="num">${money(x.deduct)}</td><td class="num"><b>${money(x.total)}</b></td><td>${x.unknown?`<span class="tag">${x.unknown}个费率桶待确认</span>`:'<span class="tag">可测算</span>'}</td></tr>`).join("")}</tbody></table></div>`;const detail=`<div class="p"><h3>逐月复核</h3><div class="muted">括号内为重叠折扣扣减；净坑位低于500显示“&lt;500”且不计入汇